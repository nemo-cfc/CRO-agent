# Free writing layer — get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional override. Default is Llama 3.3 70B, which is on Groq's free tier.
# Faster / cheaper: llama-3.1-8b-instant
CRO_MODEL=llama-3.3-70b-versatile

# Optional — real-user field performance data (Chrome UX Report).
# The CrUX track is skipped cleanly if this is unset.
CRUX_API_KEY=

# Worker
PORT=8787
POOL_SIZE=8
MAX_CONCURRENT_AUDITS=2
AUDIT_DEADLINE_MS=25000

# Frontend
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
