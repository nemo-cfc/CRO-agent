# Required — the writing layer
GROQ_API_KEY=
CRO_MODEL=openai/gpt-oss-120b
CRO_EFFORT=low

# Optional — real-user field performance data (Chrome UX Report).
# The CrUX track is skipped cleanly if this is unset.
CRUX_API_KEY=

# Worker
PORT=8787
POOL_SIZE=8
MAX_CONCURRENT_AUDITS=2
AUDIT_DEADLINE_MS=25000
AUDIT_RATE_MAX_PER_IP=3
AUDIT_RATE_WINDOW_MS=3600000
AUDIT_DUPLICATE_WINDOW_MS=1800000
TRUST_PROXY=true

# Frontend
NEXT_PUBLIC_WORKER_URL=http://localhost:8787

# Optional: Zoho Bookings/Calendar URL for expert strategy sessions.
NEXT_PUBLIC_ZOHO_CALENDAR_URL=
