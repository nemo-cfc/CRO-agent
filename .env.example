# Required — the writing layer
GROQ_API_KEY=
CRO_MODEL=openai/gpt-oss-120b
CRO_EFFORT=low

# Optional — real-user field performance data (Chrome UX Report).
# The CrUX track is skipped cleanly if this is unset.
CRUX_API_KEY=

# Worker
PORT=8787
POOL_SIZE=8
MAX_CONCURRENT_AUDITS=2
# Shared secret: set the same value on the worker and on the web app (Vercel).
# Leave empty for local development.
WORKER_TOKEN=
# Timing. The code defaults (20s / 12s / 28s) suit a fast local machine.
# A hosted worker loads pages more slowly; use these values there. The web
# app waits up to 150s for an audit, so they leave plenty of room.
AUDIT_DEADLINE_MS=35000
NAV_TIMEOUT_MS=20000
WRITE_DEADLINE_MS=45000
AUDIT_RATE_MAX_PER_IP=3
AUDIT_RATE_WINDOW_MS=3600000
AUDIT_DUPLICATE_WINDOW_MS=1800000
TRUST_PROXY=true

# Frontend
NEXT_PUBLIC_WORKER_URL=http://localhost:8787

# Optional: Zoho Bookings/Calendar URL for expert strategy sessions.
NEXT_PUBLIC_ZOHO_CALENDAR_URL=

# Public address of the web app; used for report links in Zoho CRM.
SITE_URL=https://cro.monkeyman.agency
# Signs staff report links in Zoho, so sales can open a report without the
# unlock form. Long random string (openssl rand -hex 32); changing it
# invalidates every staff link already sent.
REPORT_LINK_SECRET=

# Optional: lead backup to Supabase (server only; never NEXT_PUBLIC_).
# Project URL without /rest/v1, and the secret (service_role) key.
SUPABASE_URL=https://dighqoerdckyzqpjordg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: send leads to Zoho CRM. Use the URLs of your Zoho data centre
# (.in shown; .com / .eu / .com.au also exist).
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# API name of the Zoho module leads go into: Leads, or a custom module such
# as the one shown as "Monkeyman Paid Leads" (find its API name in Zoho).
ZOHO_MODULE=monkeyman_paid_leads
# Optional: the module's field API names, comma-separated, if the token cannot
# read field metadata. Example: Name,Email,Phone,Description
ZOHO_FIELDS=
ZOHO_LEAD_SOURCE=CRO Audit
